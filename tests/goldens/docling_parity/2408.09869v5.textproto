texts {
  text {
    base {
      self_ref: "#/texts/55"
      parent {
        ref: "#/body"
      }
      content_layer: CONTENT_LAYER_BODY
      label: DOC_ITEM_LABEL_TEXT
      prov {
        page_no: 4
        bbox {
          l: 108.0
          t: 716.5226526
          r: 504.0033873999996
          b: 664.3347743929204
          coord_origin: COORD_ORIGIN_BOTTOMLEFT
        }
        charspan {
          end: 459
        }
      }
      orig: "The Docling pipeline feeds all table objects detected in the layout analysis to the TableFormer model, by providing an image-crop of the table and the included text cells. TableFormer structure predictions are matched back to the PDF cells in post-processing to avoid expensive re-transcription text in the table image. Typical tables require between 2 and 6 seconds to be processed on a standard CPU, strongly depending on the amount of included table cells."
      text: "The Docling pipeline feeds all table objects detected in the layout analysis to the TableFormer model, by providing an image-crop of the table and the included text cells. TableFormer structure predictions are matched back to the PDF cells in post-processing to avoid expensive re-transcription text in the table image. Typical tables require between 2 and 6 seconds to be processed on a standard CPU, strongly depending on the amount of included table cells."
    }
  }
}
