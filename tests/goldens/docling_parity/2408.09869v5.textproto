          r: 299.55598297093286
          b: 370.86459271267637
          coord_origin: COORD_ORIGIN_BOTTOMLEFT
        }
        charspan {
          end: 30
        }
      }
      orig: "Baselines for Object Detection"
      text: "Baselines for Object Detection"
    }
