texts {
  text {
    base {
      self_ref: "#/texts/6"
      parent {
        ref: "#/body"
      }
      content_layer: CONTENT_LAYER_BODY
      label: DOC_ITEM_LABEL_TEXT
      prov {
        page_no: 1
        bbox {
          l: 143.86499999999995
          t: 364.0129794
          r: 468.1376673999998
          b: 300.7367743929204
          coord_origin: COORD_ORIGIN_BOTTOMLEFT
        }
        charspan {
          end: 430
        }
      }
      orig: "This technical report introduces Docling, an easy to use, self-contained, MITlicensed open-source package for PDF document conversion. It is powered by state-of-the-art specialized AI models for layout analysis (DocLayNet) and table structure recognition (TableFormer), and runs efficiently on commodity hardware in a small resource budget. The code interface allows for easy extensibility and addition of new features and models."
      text: "This technical report introduces Docling, an easy to use, self-contained, MITlicensed open-source package for PDF document conversion. It is powered by state-of-the-art specialized AI models for layout analysis (DocLayNet) and table structure recognition (TableFormer), and runs efficiently on commodity hardware in a small resource budget. The code interface allows for easy extensibility and addition of new features and models."
    }
  }
}
